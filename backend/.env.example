DATABASE_URL="postgresql://user:password@localhost:5432/business_webapp"

# Generate strong random values for these before any real deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="24h"
JWT_REMEMBER_ME_EXPIRES_IN="30d"

PORT=5000
NODE_ENV=development

# One of: fatal, error, warn, info, debug, trace. "debug" also surfaces
# expected/operational errors (4xx) in the log, not just unexpected 500s.
LOG_LEVEL=info

CLIENT_URL="http://localhost:5173"

# Gates the /api/platform/* developer/ops routes (list/delete/reset SuperAdmins)
MASTER_KEY="replace-with-a-long-random-string"

# Brevo transactional email (password-reset emails). Get the API key from
# Brevo's dashboard under SMTP & API > API Keys - never commit a real value.
BREVO_API_KEY="replace-with-your-brevo-api-key"
EMAIL_FROM_ADDRESS="vaeinventory@kingkhartel.xyz"
EMAIL_FROM_NAME="VAE Inventory"
